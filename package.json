{
  "name": "automate-trade-news",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "snapshot:pilot": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-pilot.ts",
    "test": "tsx --test src/**/*.test.ts",
    "ingest:trade": "node --env-file-if-exists=.env.local --import tsx scripts/ingest-trade.ts",
    "publish:pilot": "node --env-file-if-exists=.env.local --import tsx scripts/publish-pilot.ts",
    "publish:ranked": "node --env-file-if-exists=.env.local --import tsx scripts/publish-ranked.ts",
    "backfill:ranked": "node --env-file-if-exists=.env.local --import tsx scripts/backfill-ranked.ts",
    "generate:explanations": "node --env-file-if-exists=.env.local --import tsx scripts/generate-explanations.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
